@model Tibur_LabAct1.Models.User

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .register-wrapper {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: calc(100vh - 160px);
            padding: 40px 15px;
        }

        .register-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            padding: 40px;
            width: 100%;
            max-width: 900px;
            display: flex;
            gap: 50px;
            align-items: flex-start;
        }

        .register-form-section {
            flex: 1;
        }

            .register-form-section h4 {
                color: #3d2b7d;
                font-weight: 700;
                margin-bottom: 24px;
                font-size: 1.4rem;
            }

        .section-title {
            text-align: center;
            font-weight: 700;
            color: #3d2b7d;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.9rem;
            margin-bottom: 20px;
        }

        .form-control {
            border-radius: 6px;
            border: 1px solid #ccc;
            padding: 8px 12px;
            font-size: 0.9rem;
            width: 100%;
            box-sizing: border-box;
            font-family: inherit;
        }

            .form-control:focus {
                border-color: #3d2b7d;
                box-shadow: 0 0 0 3px rgba(61,43,125,0.15);
                outline: none;
            }

        .form-label {
            font-size: 0.8rem;
            color: #666;
            margin-bottom: 2px;
            display: block;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .btn-back {
            display: inline-block;
            padding: 7px 22px;
            background: #f0ecff;
            color: #3d2b7d;
            border-radius: 50px;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
            margin-bottom: 16px;
            transition: background 0.2s;
        }

            .btn-back:hover {
                background: #3d2b7d;
                color: #fff;
            }

        .btn-register {
            background-color: #3d2b7d;
            color: #fff;
            border: none;
            padding: 10px 40px;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            display: block;
            margin: 20px auto 0;
            width: 100%;
        }

            .btn-register:hover {
                background-color: #2e1f6b;
            }

        .register-illustration {
            flex: 0 0 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding-top: 60px;
        }

            .register-illustration img {
                width: 100%;
                max-width: 200px;
            }

        .alert-success {
            background: #d4edda;
            color: #155724;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            border: 1px solid #c3e6cb;
        }

        .alert-error {
            background: #fdecea;
            color: #c0392b;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            border: 1px solid #f5c6cb;
        }

        @@media (max-width: 640px) {
            .register-card {
                flex-direction: column;
                gap: 20px;
                padding: 24px 16px;
            }

            .register-illustration {
                padding-top: 0;
                flex: auto;
            }
        }
    </style>
}

<div class="register-wrapper">
    <div class="register-card">

        <div class="register-form-section">

            <a asp-action="Login" asp-controller="Account" class="btn-back">← Back</a>

            <p class="section-title">REGISTRATION</p>
            <h4>Sign up</h4>

            @if (TempData["Success"] != null)
            {
                <div class="alert-success">✅ @TempData["Success"]</div>
            }

            @if (ViewBag.Error != null)
            {
                <div class="alert-error">❌ @ViewBag.Error</div>
            }

            <form method="post" action="/Account/Register">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <input asp-for="IdNumber" class="form-control" placeholder="ID Number" required />
                    <label class="form-label">ID Number</label>
                </div>

                <div class="form-group">
                    <input asp-for="LastName" class="form-control" placeholder="Last Name" required />
                    <label class="form-label">Last Name</label>
                </div>

                <div class="form-group">
                    <input asp-for="FirstName" class="form-control" placeholder="First Name" required />
                    <label class="form-label">First Name</label>
                </div>

                <div class="form-group">
                    <input asp-for="MiddleName" class="form-control" placeholder="Middle Name" />
                    <label class="form-label">Middle Name</label>
                </div>

                <div class="form-group">
                    <select name="CourseLvl" class="form-control" required>
                        <option value="" disabled selected style="color:#aaa;">Select Year Level</option>
                        <option value="1">1st Year</option>
                        <option value="2">2nd Year</option>
                        <option value="3">3rd Year</option>
                        <option value="4">4th Year</option>
                    </select>
                    <label class="form-label">Year Level</label>
                </div>

                <div class="form-group">
                    <select name="Course" class="form-control" required>
                        <option value="" disabled selected style="color:#aaa;">Select Course</option>
                        <option value="BSIT">BSIT</option>
                        <option value="BSCS">BSCS</option>
                        <option value="BSIS">BSIS</option>
                        <option value="ACT">ACT</option>
                    </select>
                    <label class="form-label">Course</label>
                </div>

                <div class="form-group">
                    <input asp-for="Email" class="form-control" type="email"
                           placeholder="Email" required />
                    <label class="form-label">Email</label>
                </div>

                <div class="form-group">
                    <input asp-for="Address" class="form-control" placeholder="Address" />
                    <label class="form-label">Address</label>
                </div>

                <div class="form-group">
                    <input asp-for="Password" class="form-control" type="password"
                           placeholder="Password" required />
                    <label class="form-label">Password</label>
                </div>

                <div class="form-group">
                    <input asp-for="RepeatPassword" class="form-control" type="password"
                           placeholder="Repeat your password" />
                    <label class="form-label">Repeat Password</label>
                </div>

                <button type="submit" class="btn-register">Register</button>
            </form>

        </div>

        <div class="register-illustration">
            <img src="~/logo/uclogo.jpg" alt="UC logo" />
        </div>

    </div>
</div>