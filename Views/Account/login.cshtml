@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 160px);
            padding: 40px 15px;
        }

        .login-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.1);
            padding: 50px 40px;
            width: 100%;
            max-width: 900px;
            display: flex;
            align-items: center;
            gap: 60px;
        }

        .login-logo {
            flex: 0 0 auto;
            text-align: center;
        }

            .login-logo img {
                width: 200px;
                height: auto;
            }

        .login-form-section {
            flex: 1;
        }

            .login-form-section h4 {
                color: #3d2b7d;
                font-weight: 700;
                margin-bottom: 24px;
                font-size: 1.4rem;
            }

        .form-control {
            border-radius: 6px;
            border: 1px solid #ccc;
            padding: 10px 14px;
            font-size: 0.95rem;
            width: 100%;
            margin-bottom: 4px;
        }

            .form-control:focus {
                border-color: #3d2b7d;
                box-shadow: 0 0 0 3px rgba(61,43,125,0.15);
                outline: none;
            }

        .form-label {
            font-size: 0.85rem;
            color: #555;
            margin-bottom: 4px;
        }

        .form-group {
            margin-bottom: 18px;
        }

        .btn-login {
            background-color: #1a73e8;
            color: #fff;
            border: none;
            padding: 10px 40px;
            border-radius: 6px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s;
            display: block;
            margin: 24px auto 0;
        }

            .btn-login:hover {
                background-color: #1558b0;
            }

        .login-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 8px;
        }

            .login-options label {
                font-size: 0.85rem;
                color: #555;
            }

        .forgot-link {
            font-size: 0.85rem;
            color: #1a73e8;
            text-decoration: none;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .register-hint {
            text-align: center;
            margin-top: 16px;
            font-size: 0.875rem;
            color: #555;
        }

            .register-hint a {
                color: #c0392b;
                font-weight: 600;
                text-decoration: none;
            }

                .register-hint a:hover {
                    text-decoration: underline;
                }

        @@media (max-width: 640px) {
            .login-card {
                flex-direction: column;
                gap: 30px;
                padding: 30px 20px;
            }
        }
    </style>
}

<div class="login-wrapper">
    <div class="login-card">

        <div class="login-logo">
            <img src="~/logo/ccs.png" alt="CCS Logo" />
        </div>

        <div class="login-form-section">
            <h4>Sign In to Your Account</h4>

            <form method="post" action="/Account/Login">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <input type="text" class="form-control" name="IdNumber"
                           placeholder="Enter a valid id number" required />
                    <label class="form-label">ID Number</label>
                </div>

                <div class="form-group">
                    <input type="password" class="form-control" name="Password"
                           placeholder="Enter password" required />
                    <label class="form-label">Password</label>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div style="background:#fdecea; color:#c0392b; padding:10px 14px; border-radius:6px; margin-bottom:16px; font-size:0.875rem;">
                        @ViewBag.Error
                    </div>
                }

                <div class="login-options">
                    <label>
                        <input type="checkbox" name="RememberMe" /> Remember me
                    </label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login">Login</button>
            </form>

            <p class="register-hint">
                Don't have an account? <a asp-action="Register" asp-controller="Account">Register</a>
            </p>
        </div>

    </div>
</div>