@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var student = ViewBag.Student;
    var announcements = ViewBag.Announcements as List<Tibur_LabAct1.Models.Announcement>;
    var myFeedbacks = ViewBag.MyFeedbacks as List<Tibur_LabAct1.Models.Feedback>;
    var myReservations = ViewBag.MyReservations as List<Tibur_LabAct1.Models.Reservation> ?? new List<Tibur_LabAct1.Models.Reservation>();
    var mySitIns = ViewBag.MySitIns as List<Tibur_LabAct1.Models.SitIn> ?? new List<Tibur_LabAct1.Models.SitIn>();
}

@section Styles {
    <style>
        body {
            background-color: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
        }

        .topnav {
            background-color: #3d2b7d;
            display: flex;
            align-items: center;
            padding: 0 30px;
            min-height: 52px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
            position: sticky;
            top: 0;
            z-index: 100;
            margin-left: calc(50% - 50vw);
            width: 100vw;
        }

        .topnav-brand {
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            margin-right: 32px;
            white-space: nowrap;
        }

        .topnav-links {
            display: flex;
            flex: 1;
            overflow-x: auto;
        }

        .topnav-link {
            color: rgba(255,255,255,0.75);
            text-decoration: none;
            font-size: 0.875rem;
            font-weight: 600;
            padding: 0 14px;
            height: 52px;
            display: flex;
            align-items: center;
            cursor: pointer;
            white-space: nowrap;
            user-select: none;
        }

            .topnav-link:hover {
                color: #fff;
            }

            .topnav-link.active {
                color: #fff;
                border-bottom: 3px solid #fff;
            }

        .page-section {
            display: none;
            margin-left: calc(50% - 50vw);
            width: 100vw;
        }

            .page-section.active {
                display: block;
            }

        .dashboard-wrapper {
            padding: 30px;
            display: grid;
            grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
            gap: 24px;
        }

        .student-info-card,
        .announcement-card,
        .rules-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }

        .card-header {
            background: #3d2b7d;
            color: #fff;
            padding: 10px 16px;
            font-weight: 700;
            border-radius: 8px 8px 0 0;
        }

        .student-avatar {
            text-align: center;
            padding: 20px;
        }

        .avatar-image {
            width: 112px;
            height: 112px;
            border-radius: 50%;
            object-fit: cover;
        }

        .avatar-placeholder {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3d2b7d, #6a4fc9);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 2rem;
            margin: auto;
        }

        .profile-upload-form {
            margin-top: 14px;
            display: grid;
            gap: 10px;
        }

        .profile-file-input {
            display: none;
        }

        .profile-edit-btn {
            background: #3d2b7d;
            color: #fff;
            border: none;
            border-radius: 4px;
            padding: 8px 12px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-block;
        }

            .profile-edit-btn:hover {
                background: #2e1f6b;
            }

        .student-details {
            padding: 16px 20px;
        }

        .detail-row {
            display: flex;
            gap: 10px;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
            font-size: 0.9rem;
        }

        .detail-label {
            font-weight: 700;
            min-width: 70px;
        }

        .logout-btn {
            width: 100%;
            background: #c0392b;
            color: #fff;
            border: none;
            padding: 10px;
            margin-top: 16px;
            cursor: pointer;
            border-radius: 4px;
            font-size: 0.9rem;
            font-weight: 600;
        }

            .logout-btn:hover {
                background: #a93226;
            }

        .analytics-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            margin-bottom: 20px;
        }

        .analytics-card {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            display: flex;
            gap: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            align-items: center;
        }

        .analytics-icon {
            font-size: 1.5rem;
        }

        .analytics-value {
            font-size: 1.3rem;
            font-weight: 700;
            color: #3d2b7d;
        }

        .analytics-label {
            font-size: 0.8rem;
            color: #666;
        }

        .empty-state {
            padding: 20px;
            text-align: center;
            color: #888;
        }

        .rules-content {
            padding: 20px 24px;
            line-height: 1.7;
        }

            .rules-content h3 {
                font-size: 1rem;
                font-weight: 700;
                color: #3d2b7d;
                margin: 0 0 4px 0;
                text-align: center;
            }

            .rules-content h4 {
                font-size: 0.95rem;
                font-weight: 700;
                color: #3d2b7d;
                margin: 0 0 16px 0;
                text-align: center;
            }

            .rules-content p {
                margin: 6px 0;
                font-size: 0.9rem;
                color: #333;
            }

        .rules-intro {
            font-style: italic;
            color: #555;
            margin-bottom: 12px !important;
        }

        .placeholder-wrapper {
            padding: 30px;
        }

        .placeholder-card {
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .feedback-textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 0.9rem;
            font-family: inherit;
            resize: vertical;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .feedback-textarea:focus {
                border-color: #3d2b7d;
                outline: none;
                box-shadow: 0 0 0 3px rgba(61,43,125,0.12);
            }

        .feedback-submit-btn {
            background: #3d2b7d;
            color: #fff;
            border: none;
            padding: 11px 32px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
        }

            .feedback-submit-btn:hover {
                background: #2e1f6b;
            }

        .alert-success {
            background: #d4edda;
            color: #155724;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .alert-error {
            background: #fdecea;
            color: #c0392b;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-weight: 600;
        }

        /* Shared table style */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.88rem;
        }

            .data-table th {
                background: #f0ecff;
                color: #3d2b7d;
                padding: 10px 14px;
                text-align: left;
                font-weight: 700;
            }

            .data-table td {
                padding: 10px 14px;
                border-bottom: 1px solid #f0f0f0;
                color: #333;
            }

            .data-table tr:hover td {
                background: #faf9ff;
            }

        /* Reservation form */
        .res-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 700;
            color: #555;
        }

        .form-input {
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 0.9rem;
            font-family: inherit;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }

            .form-input:focus {
                border-color: #3d2b7d;
                outline: none;
                box-shadow: 0 0 0 3px rgba(61,43,125,0.12);
            }

        .btn-submit {
            background: #3d2b7d;
            color: #fff;
            border: none;
            padding: 11px 32px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
        }

            .btn-submit:hover {
                background: #2e1f6b;
            }

        /* Status badges */
        .badge-active {
            background: #d4edda;
            color: #155724;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-done {
            background: #f0ecff;
            color: #3d2b7d;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-pending {
            background: #fff3cd;
            color: #856404;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-approved {
            background: #d4edda;
            color: #155724;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .badge-rejected {
            background: #fdecea;
            color: #c0392b;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        @@media (max-width: 900px) {
            .topnav {
                align-items: flex-start;
                flex-direction: column;
                padding: 12px 16px;
            }

            .topnav-brand {
                margin-right: 0;
            }

            .topnav-links {
                width: 100%;
                flex-wrap: wrap;
                overflow-x: visible;
            }

            .topnav-link {
                height: 36px;
                padding: 0 10px;
            }

            .dashboard-wrapper {
                grid-template-columns: 1fr;
                padding: 20px 16px;
            }

            .placeholder-wrapper {
                padding: 20px 16px;
            }

            .analytics-row,
            .res-form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- TOP NAV -->
<nav class="topnav">
    <span class="topnav-brand">Student Dashboard</span>
    <div class="topnav-links">
        <a class="topnav-link active" onclick="showSection('sec-dashboard', this)">Home</a>
        <a class="topnav-link" onclick="showSection('sec-sitin', this)">Sit-in History</a>
        <a class="topnav-link" onclick="showSection('sec-feedback', this)">Feedback</a>
        <a class="topnav-link" onclick="showSection('sec-reservation', this)">Reservation</a>
        <a class="topnav-link" onclick="showSection('sec-rewards', this)">Rewards</a>
        <a class="topnav-link" onclick="showSection('sec-notifications', this)">Notifications</a>
    </div>
</nav>

<!-- ===== DASHBOARD ===== -->
<div id="sec-dashboard" class="page-section active">
    <div class="dashboard-wrapper">

        <!-- LEFT -->
        <div>
            <div class="student-info-card">
                <div class="card-header">Student Information</div>
                <div class="student-avatar">
                    @if (student?.ProfilePicture != null)
                    {
                        <img src="@student.ProfilePicture"
                             class="avatar-image"
                             id="profilePreview"
                             alt="Profile picture" />
                        <div class="avatar-placeholder" id="profilePlaceholder" style="display:none;">🎓</div>
                    }
                    else
                    {
                        <img src=""
                             class="avatar-image"
                             id="profilePreview"
                             alt="Profile picture preview"
                             style="display:none;" />
                        <div class="avatar-placeholder" id="profilePlaceholder">🎓</div>
                    }
                    <form asp-controller="Account"
                          asp-action="UpdateProfilePicture"
                          method="post"
                          enctype="multipart/form-data"
                          id="profilePictureForm"
                          class="profile-upload-form">
                        @Html.AntiForgeryToken()
                        <input type="file"
                               name="ProfilePicture"
                               class="profile-file-input"
                               id="profilePictureInput"
                               accept="image/*"
                               required />
                        <label for="profilePictureInput" class="profile-edit-btn">Edit Profile</label>
                    </form>
                </div>
                <div class="student-details">
                    @if (TempData["ProfileSuccess"] != null)
                    {
                        <div class="alert-success">@TempData["ProfileSuccess"]</div>
                    }
                    @if (TempData["ProfileError"] != null)
                    {
                        <div class="alert-error">@TempData["ProfileError"]</div>
                    }
                    <div class="detail-row">
                        <span class="detail-label">Name:</span>
                        <span>@student?.FirstName @student?.LastName</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">ID:</span>
                        <span>@student?.IdNumber</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Course:</span>
                        <span>@student?.Course</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Year:</span>
                        <span>@student?.CourseLvl</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Email:</span>
                        <span style="word-break:break-all;">@student?.Email</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Address:</span>
                        <span>@student?.Address</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Session:</span>
                        <span>@student?.RemainingSession</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="logout-btn">Logout</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div>
            <div class="analytics-row">
                <div class="analytics-card">
                    <div class="analytics-icon">📋</div>
                    <div>
                        <div class="analytics-value">@ViewBag.TotalSitIns</div>
                        <div class="analytics-label">Total Sit-ins</div>
                    </div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-icon">📅</div>
                    <div>
                        <div class="analytics-value">@ViewBag.TotalReservations</div>
                        <div class="analytics-label">Reservations</div>
                    </div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-icon">🏆</div>
                    <div>
                        <div class="analytics-value">@ViewBag.TotalPoints</div>
                        <div class="analytics-label">Points</div>
                    </div>
                </div>
                <div class="analytics-card">
                    <div class="analytics-icon">⏱️</div>
                    <div>
                        <div class="analytics-value">@student?.RemainingSession</div>
                        <div class="analytics-label">Sessions Left</div>
                    </div>
                </div>
            </div>

            <!-- ANNOUNCEMENTS -->
            <div class="announcement-card">
                <div class="card-header">Announcements</div>
                @if (announcements != null && announcements.Any())
                {
                    foreach (var item in announcements)
                    {
                        <div style="padding:15px;border-bottom:1px solid #eee;">
                            <b>@item.Title</b>
                            <div style="font-size:0.8rem;color:#888;margin:4px 0;">
                                @item.DatePosted.ToString("MMMM dd, yyyy hh:mm tt")
                            </div>
                            <div style="font-size:0.9rem;">@item.Content</div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">No announcements available.</div>
                }
            </div>

            <!-- RULES -->
            <div class="rules-card">
                <div class="card-header">Lab Rules &amp; Regulations</div>
                <div class="rules-content">
                    <h3>UNIVERSITY OF CEBU – MAIN CAMPUS</h3>
                    <h4>LABORATORY RULES AND REGULATIONS</h4>
                    <p class="rules-intro">To avoid embarrassment and maintain camaraderie inside the computer laboratory, the following rules and regulations are to be strictly observed:</p>
                    <p>1. Maintain silence, proper decorum, and discipline inside the laboratory.</p>
                    <p>2. Games are strictly prohibited inside the lab.</p>
                    <p>3. Surfing the internet is allowed only with the permission of the instructor.</p>
                    <p>4. Eating and drinking are not allowed inside the lab.</p>
                    <p>5. Observe cleanliness and orderliness at all times.</p>
                    <p>6. Absence of laboratory gown is not allowed.</p>
                    <p>7. Students are required to log in and log out upon entering and leaving the laboratory.</p>
                    <p>8. Students must bring their own laboratory materials.</p>
                    <p>9. No vandalism of any kind is allowed.</p>
                    <p>10. Students are held responsible for any damage to the equipment.</p>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- ===== SIT-IN HISTORY ===== -->
<div id="sec-sitin" class="page-section">
    <div class="placeholder-wrapper">
        <div class="placeholder-card">
            <div class="card-header">Sit-in History</div>
            <div style="padding: 20px; overflow-x: auto;">
                @if (mySitIns.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr>
                                
                                <th>Lab</th>
                                <th>Purpose</th>
                                <th>Time In</th>
                                <th>Time Out</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            
                            @foreach (var s in mySitIns)
                            {
                                <tr>
                                     
                                    <td>@s.Lab</td>
                                    <td>@s.Purpose</td>
                                    <td>@s.TimeIn.ToString("MM/dd/yyyy hh:mm tt")</td>
                                    <td>@(s.TimeOut.HasValue? s.TimeOut.Value.ToString("MM/dd/yyyy hh:mm tt") : "—")</td>
                                    <td>
                                        <span class="@(s.Status == "Active" ? "badge-active" : "badge-done")">
                                            @s.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align:center; color:#aaa; padding:40px 0; font-size:0.95rem;">
                        💻 You have no sit-in records yet.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- ===== FEEDBACK ===== -->
<div id="sec-feedback" class="page-section">
    <div class="placeholder-wrapper">

        @if (TempData["FeedbackSuccess"] != null)
        {
            <div class="alert-success">✅ @TempData["FeedbackSuccess"]</div>
        }
        @if (TempData["FeedbackError"] != null)
        {
            <div class="alert-error">❌ @TempData["FeedbackError"]</div>
        }

        <div class="placeholder-card">
            <div class="card-header">Submit Feedback</div>
            <div style="padding: 24px;">
                <form asp-controller="Account" asp-action="SubmitFeedback" method="post">
                    @Html.AntiForgeryToken()
                    <div style="margin-bottom: 20px;">
                        <label style="display:block; font-weight:700; font-size:0.88rem; color:#555; margin-bottom:8px;">
                            Your Feedback
                        </label>
                        <textarea name="message"
                                  class="feedback-textarea"
                                  rows="5"
                                  required
                                  placeholder="Share your experience in the laboratory..."></textarea>
                    </div>
                    <button type="submit" class="feedback-submit-btn">Submit Feedback</button>
                </form>
            </div>
        </div>

        <div class="placeholder-card" style="margin-top: 20px;">
            <div class="card-header">Your Previous Feedback</div>
            <div style="padding: 20px;">
                @if (myFeedbacks != null && myFeedbacks.Any())
                {
                    foreach (var f in myFeedbacks)
                    {
                        <div style="padding:14px 0; border-bottom:1px solid #eee;">
                            <div style="color:#333; font-size:0.9rem; margin-bottom:6px;">@f.Message</div>
                            <div style="font-size:0.78rem; color:#aaa;">
                                @f.DateSubmitted.ToString("MMMM dd, yyyy hh:mm tt")
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="text-align:center; color:#aaa; padding:20px 0; font-size:0.9rem;">
                        You have not submitted any feedback yet.
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<!-- ===== RESERVATION ===== -->
<div id="sec-reservation" class="page-section">
    <div class="placeholder-wrapper">

        @if (TempData["ReservationSuccess"] != null)
        {
            <div class="alert-success">✅ @TempData["ReservationSuccess"]</div>
        }
        @if (TempData["ReservationError"] != null)
        {
            <div class="alert-error">❌ @TempData["ReservationError"]</div>
        }

        <!-- Reservation Form -->
        <div class="placeholder-card" style="margin-bottom: 20px;">
            <div class="card-header">Reserve a Laboratory</div>
            <div style="padding: 24px;">
                <form asp-controller="Account" asp-action="SubmitReservation" method="post">
                    @Html.AntiForgeryToken()
                    <div class="res-form-grid">
                        <div class="form-group">
                            <label class="form-label">Laboratory</label>
                            <select name="Lab" class="form-input" required>
                                <option value="">-- Select Lab --</option>
                                <option value="Lab 524">Lab 524</option>
                                <option value="Lab 526">Lab 526</option>
                                <option value="Lab 528">Lab 528</option>
                                <option value="Lab 530">Lab 530</option>
                                <option value="Lab 542">Lab 542</option>
                                <option value="Lab 544">Lab 544</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Purpose</label>
                            <input type="text" name="Purpose" class="form-input"
                                   placeholder="e.g. C#, Java, PHP" required />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Date</label>
                            <input type="date" name="ReservationDate" class="form-input" required
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Time</label>
                            <input type="time" name="ReservationTime" class="form-input" required />
                        </div>
                    </div>
                    <button type="submit" class="btn-submit">Submit Reservation</button>
                </form>
            </div>
        </div>

        <!-- Reservation History -->
        <div class="placeholder-card">
            <div class="card-header">My Reservations</div>
            <div style="padding: 20px; overflow-x: auto;">
                @if (myReservations.Any())
                {
                    <table class="data-table">
                        <thead>
                            <tr>

                                <th>Lab</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Purpose</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            
                            @foreach (var r in myReservations)
                            {
                                <tr>
                                   
                                    <td>@r.Lab</td>
                                    <td>@r.ReservationDate.ToString("MM/dd/yyyy")</td>
                                    <td>@r.ReservationTime</td>
                                    <td>@r.Purpose</td>
                                    <td>
                                        <span class="@(r.Status == "Approved" ? "badge-approved" : r.Status == "Rejected" ? "badge-rejected" : "badge-pending")">
                                            @r.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align:center; color:#aaa; padding:20px 0; font-size:0.9rem;">
                        You have no reservations yet.
                    </div>
                }
            </div>
        </div>

    </div>
</div>

